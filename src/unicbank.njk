  <!-- 03 — CHALLENGE -->
  <div class="case-shell" id="challenge">
    <section class="case-section">
      <p class="sec-label">3. The challenge</p>
      <h2 class="case-heading">
        Unlock useful banking actions before full account setup — then
        progressively guide users toward full banking functionality.
      </h2>
      <div class="challenge-pair">
        <div class="challenge-card challenge-card--neutral">
          <p class="challenge-card-label">Core banking requirements</p>
          <h3 class="challenge-card-title">What the product had to support</h3>
          <ul class="challenge-list">
            <li>1. Registration and bank account opening</li>
            <li>2. UNIC Bank cards and third-party card management</li>
            <li>3. Domestic and international transfers</li>
          </ul>
        </div>
        <div class="challenge-card challenge-card--violet">
          <p class="challenge-card-label">What had to be different</p>
          <h3 class="challenge-card-title">Reduce time to first value</h3>
          <p>
            Competing apps front-load setup before users can do anything useful.
            UNIC needed to reverse that order without making the product feel incomplete.
          </p>
        </div>
      </div>
    </section>
  </div>

